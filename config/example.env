# Environment overrides (upstream `TE_*` convention).
#
# Export what you need in the environment that launches DSH. Variables override
# profile config and project-scoped settings for that process only. Do not put
# secrets here: this plugin has none and reads none.

# Whole-plugin kill switch (1/0, on/off, true/false, yes/no)
TE_DISABLE=0

# State directory (absolute path, or a leading ~ is expanded). Default:
# $DSH_HOME/tokeneconomizer
# TE_DATA_DIR=/absolute/path/to/state

# Mechanism modes
TE_MICROSKILLS=off          # off | envfacts | on
TE_TOOLPRUNE=propose        # off | propose | apply
TE_LOOPGUARD=on             # off | on

# Micro-skills
TE_MICROSKILLS_PROPOSE_EVERY=3
TE_MICROSKILLS_MAX_CHARS=600
TE_MICROSKILLS_MAX_FACTS=4

# Tool pruning evidence and policy
TE_TOOLPRUNE_EVIDENCE=10
TE_TOOLPRUNE_MIN_SESSIONS=2
TE_TOOLPRUNE_SESSIONS=5
TE_TOOLPRUNE_QUIET_MINUTES=60
TE_TOOLPRUNE_PROTECTED=some_tool,another_tool

# Loop guard
TE_LOOPGUARD_ENVELOPE_MIN_SAMPLES=5
TE_LOOPGUARD_JUDGE_CONFIDENCE=0.7
TE_LOOPGUARD_NUDGES=1
TE_LOOPGUARD_BACKSTOP_MULT=2.5
TE_LOOPGUARD_JUDGE_MIN_INTERVAL_MS=120000
TE_LOOPGUARD_JUDGE=1

# Usage and diagnostics
TE_USAGE_RECORD=1
TE_DIAGNOSTICS_RECORD=1
TE_DIAGNOSTICS=redacted        # redacted | off
TE_DIAGNOSTICS_MAX_BYTES=65536
